[Unit]
Description=Funding Bot Hybrid Headless Service
After=network.target

[Service]
Type=simple
EnvironmentFile=/home/johnd/funding-hybrid/.env
User=johnd
WorkingDirectory=/home/johnd/funding-hybrid
ExecStart=/home/johnd/funding-hybrid/venv/bin/python /home/johnd/funding-hybrid/funding_bot_real.py --headless
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
