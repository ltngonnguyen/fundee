# Hyperliquid credentials
# 1. Create an API wallet in the Hyperliquid UI under "More -> API Wallets".
#    API wallets can trade but cannot withdraw — use one instead of your main key.
# 2. Copy this file to .env and fill in the two values below.
# 3. Run with:  uv run --env-file .env python fundee.py --headless

HL_WALLET_ADDRESS=0xYourMainAccountAddress
HL_API_PRIVATE_KEY=0xYourApiWalletPrivateKey

# Optional overrides:
# HL_BASE_URL=https://api.hyperliquid.xyz   (default)
# HL_TESTNET=1                              (set to 1 to use Hyperliquid testnet)
